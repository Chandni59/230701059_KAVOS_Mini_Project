<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Circular avatar -->
        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ic_avatar_bg"
            android:textColor="@color/purple_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Name / phone / message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvGName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/purple_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvGPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/purple_muted"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvGMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btnDeleteGuardian"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:backgroundTint="@color/purple_light"
            android:background="@drawable/ic_avatar_bg"
            android:contentDescription="Delete guardian"
            android:padding="6dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>