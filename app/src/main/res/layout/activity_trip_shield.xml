<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Gradient hero header -->
    <FrameLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="22dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="#FFFFFF"
                android:layout_marginStart="-12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRIP SHIELD · NEW"
                android:textColor="#FFFFFFCC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginTop="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guarded trip mode"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-shares your location every 2 min · Fires SOS if you don't check in"
                android:textColor="#F0FFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Active trip banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardActiveTrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sos_red"
                app:cardCornerRadius="14dp"
                app:cardElevation="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛡 TRIP IN PROGRESS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>

                    <TextView
                        android:id="@+id/tvActiveLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Walking home"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvActiveCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ends in 28:42"
                        android:textColor="#FFE5E5"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImSafeBig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I'M SAFE — END TRIP"
                        android:textColor="@color/sos_red"
                        android:textStyle="bold"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginTop="14dp"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Setup form (hidden during trip) -->
            <LinearLayout
                android:id="@+id/setupForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WHAT KIND OF TRIP?"
                    android:textColor="@color/purple_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/togType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeWalk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Walking"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeCab"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="In a cab"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeOther"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Other"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXPECTED DURATION"
                    android:textColor="@color/purple_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/togDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDur10"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10 min"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDur30"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30 min"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDur60"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="60 min"
                        android:textSize="12sp"
                        app:strokeColor="@color/purple_primary"
                        android:textColor="@color/purple_primary"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- How it works -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HOW IT GUARDS YOUR TRIP"
                            android:textColor="@color/purple_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.18"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Sends a starting Maps link to all guardians\n• Re-sends your live location every 2 minutes\n• Shows a sticky notification with one-tap I'm Safe\n• If you don't end the trip in time, fires a full SOS automatically"
                            android:textColor="@color/purple_text"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="START TRIP SHIELD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@color/purple_primary"
                    android:layout_marginTop="22dp"
                    android:minHeight="52dp"
                    app:cornerRadius="14dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
