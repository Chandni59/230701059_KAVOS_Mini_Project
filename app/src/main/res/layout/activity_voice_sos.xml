<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tvVoiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice SOS"
            android:textColor="@color/purple_text"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvVoiceSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='Say "help me", "save me", "bachao", or "madad" to trigger SOS'
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="48dp">

            <View
                android:id="@+id/pulseDot"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_pulse_ring"
                android:alpha="0.3"
                android:visibility="invisible"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/micCard"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                app:cardCornerRadius="60dp"
                app:cardBackgroundColor="@color/purple_primary"
                app:cardElevation="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="#FFFFFF"
                    android:scaleType="center"
                    android:padding="28dp"
                    android:contentDescription="Microphone"/>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap below to start listening"
            android:textColor="@color/purple_text"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:padding="16dp"
            android:minHeight="64dp"
            android:background="@drawable/rounded_card_bg"/>

        <Button
            android:id="@+id/btnToggleVoice"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:text="Start Listening"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/purple_primary"
            android:layout_marginTop="32dp"
            app:cornerRadius="26dp"/>

    </LinearLayout>
</ScrollView>
