<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <!-- Purple header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAVOS"
                android:textColor="#BBAAFF"
                android:textSize="11sp"
                android:letterSpacing="0.15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearest Help"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="One-tap call &amp; map directions"
                android:textColor="#CCBBFF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Map shortcuts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIND NEAR ME"
                android:textColor="@color/purple_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="3"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapPolice"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Police"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:textColor="@color/purple_primary"
                    app:strokeColor="@color/purple_primary"
                    app:icon="@drawable/ic_zone_police"
                    app:iconSize="16dp"
                    app:iconPadding="4dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/purple_primary"
                    android:layout_marginEnd="6dp"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapHospital"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hospital"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:textColor="@color/purple_primary"
                    app:strokeColor="@color/purple_primary"
                    app:icon="@drawable/ic_zone_hospital"
                    app:iconSize="16dp"
                    app:iconPadding="4dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/purple_primary"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:cornerRadius="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapPharmacy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pharmacy"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:textColor="@color/purple_primary"
                    app:strokeColor="@color/purple_primary"
                    app:icon="@drawable/ic_first_aid"
                    app:iconSize="16dp"
                    app:iconPadding="4dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/purple_primary"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <!-- Helpline list header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY HELPLINES"
                android:textColor="@color/purple_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/helplineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
