<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Purple header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="22dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAVOS"
                android:textColor="#BBAAFF"
                android:textSize="11sp"
                android:letterSpacing="0.18"/>

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stay Safe"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="#CCBBFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHowToUse"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_help_circle"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:contentDescription="How to use KAVOS"/>

        <ImageButton
            android:id="@+id/btnProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:contentDescription="Profile"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- AI safety nudge (hidden until a tip is available) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAiTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/grad_indigo_a"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvAiTip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>

                    <TextView
                        android:id="@+id/btnDismissAiTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:padding="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss tip"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SOS countdown banner -->
            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/sos_red"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:text="Sending SOS... Tap to cancel"/>

            <!-- Last SOS status banner (live ack indicator) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLastSOS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <View
                        android:id="@+id/lastSosDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_indicator_inactive"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLastSosTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/purple_text"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLastSosSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SOS button with pulse ring -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/sosRing"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pulse_ring_red"
                    android:alpha="0.6"/>

                <Button
                    android:id="@+id/btnSOS"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:text="SOS"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/sos_red"
                    android:layout_gravity="center"
                    app:cornerRadius="80dp"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hold_sos"
                android:textSize="11sp"
                android:textColor="@color/purple_muted"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginTop="6dp"/>

            <!-- Safe check-in pill (positive counterpart to SOS) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImSafe"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:text="I'm Safe — Ping Guardians"
                android:textColor="@color/green_safe"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_check_circle"
                app:iconTint="@color/green_safe"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:strokeColor="@color/green_safe"
                app:strokeWidth="1dp"
                app:cornerRadius="22dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minHeight="40dp"/>

            <!-- Live status row -->
            <TextView
                android:id="@+id/tvStatusRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shake: ON  •  Trip Shield: OFF"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- Section header for feature grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUICK ACTIONS"
                    android:textColor="@color/purple_muted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hold any tile to learn"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="italic"/>
            </LinearLayout>

            <!-- Feature tile grid (populated programmatically) -->
            <GridLayout
                android:id="@+id/featureGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="6"
                android:layout_marginBottom="16dp"/>

            <!-- Guardian card with footer links -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGuardians"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="YOUR GUARDIANS"
                                android:textColor="@color/purple_muted"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.18"/>

                            <TextView
                                android:id="@+id/tvGuardianCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/purple_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:background="@drawable/tile_badge_bg"
                                android:backgroundTint="@color/purple_light"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvContactList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:textColor="@color/purple_text"
                            android:textSize="14sp"
                            android:lineSpacingExtra="6dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/purple_light"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnGoToManage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Manage"
                            android:textColor="@color/purple_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/purple_light"/>

                        <TextView
                            android:id="@+id/btnHistory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="History"
                            android:textColor="@color/purple_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/purple_light"/>

                        <TextView
                            android:id="@+id/btnHandbook"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Handbook"
                            android:textColor="@color/purple_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="12dp"
                            android:background="?attr/selectableItemBackground"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
